#!/usr/bin/env bash
printf 'ip %s\n' "$*" >> "${REGISTRO:?}"
case "$*" in
  *"route show default"*) echo "default via 192.168.1.1 dev eth0 proto dhcp src 192.168.1.50 metric 100" ;;
  *"route show dev eth0 proto kernel scope link"*) echo "192.168.1.0/24 proto kernel scope link src 192.168.1.50 metric 100" ;;
esac
