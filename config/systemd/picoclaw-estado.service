[Unit]
Description=PicoClaw: genera el informe de estado que lee el asistente

[Service]
Type=oneshot
# El informe se genera como root (para consultar Tailscale y el cortafuegos), pero el fichero
# lo escribe el usuario picoclaw: si ese usuario estuviera comprometido y dejara un enlace
# simbólico en su carpeta, root no escribiría a través de él.
ExecStart=/bin/sh -c '/usr/local/lib/exitnode/scripts/status.sh --texto 2>&1 | /usr/bin/setpriv --reuid=picoclaw --regid=picoclaw --init-groups /bin/sh -c "umask 027; cat > /var/lib/picoclaw/workspace/.estado.tmp && mv -f /var/lib/picoclaw/workspace/.estado.tmp /var/lib/picoclaw/workspace/estado.txt"'
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/picoclaw/workspace
